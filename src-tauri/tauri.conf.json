{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Messenger",
  "version": "1.0.5",
  "identifier": "com.messenger.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Messenger",
        "label": "main",
        "width": 1200,
        "height": 840,
        "minWidth": 450,
        "minHeight": 500,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Official Facebook Messenger Desktop Client with Native Windows & Linux Notifications",
    "longDescription": "A sleek, native desktop client for Facebook Messenger featuring full Windows toast notifications, unread badges, system tray integration, and custom toolbar.",
    "copyright": "Copyright © 2026",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
